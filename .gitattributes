# GitHub fills in .git_archival.txt when it builds a zip or tarball, so a
# download without git history still knows its version (setuptools_scm).
.git_archival.txt  export-subst

# cmd can fail to find a :label (call :find_python, goto :no_python) in a
# batch file with Unix line endings, so check .bat files out with CRLF.
*.bat  text eol=crlf
